# ============================================
# CryptoVault Environment Variables
# Copy to .env and fill in values
# ============================================

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cryptovault
DATABASE_USER=cryptovault
DATABASE_PASSWORD=change_me_in_production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
API_PORT=3000
API_BASE_URL=https://api.cryptovault.fraktion.io
JWT_SECRET=change_me_in_production
API_KEY_SALT=change_me_in_production

# --- Custodian (Taurus-PROTECT) ---
TAURUS_API_URL=https://api.sandbox.taurusprotect.com
TAURUS_API_KEY=
TAURUS_API_SECRET=
TAURUS_WEBHOOK_SECRET=

# --- KYC (Sumsub) ---
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=cryptovault-kyc

# --- AML (Chainalysis KYT) ---
CHAINALYSIS_API_KEY=
CHAINALYSIS_API_URL=https://api.chainalysis.com/api/kyt/v2

# --- Travel Rule (Notabene) ---
NOTABENE_API_KEY=
NOTABENE_VASP_DID=
NOTABENE_API_URL=https://api.notabene.id

# --- Onboarding Portal ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Salesforce ---
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=
SF_WEBHOOK_SECRET=

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=info
